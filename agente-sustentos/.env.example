# Copia este archivo como ".env" y completa los valores para ejecutar el
# agente en local. En Vercel NO uses este archivo: configura OPENAI_API_KEY
# como variable de entorno del proyecto (process.env tiene prioridad).

# Clave de la API de OpenAI (platform.openai.com → API keys).
OPENAI_API_KEY=

# Modelo por defecto (opcional: si se quita, se usa gpt-5.6).
OPENAI_MODEL=gpt-5.6
