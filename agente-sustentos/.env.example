# Copia este archivo como ".env" y completa los valores para ejecutar el
# agente en local. En Vercel NO uses este archivo: configura GEMINI_API_KEY
# (y MAAS_* si aplica) como variables de entorno del proyecto (process.env
# tiene prioridad).

# ── Proveedor del ANÁLISIS (quién genera los informes) ──
# "maas"   → MaaS de Huawei (ModelArts Studio), PRODUCCIÓN: chat compatible
#            con OpenAI. Requiere MAAS_API_KEY, MAAS_BASE_URL y
#            MAAS_ANALISIS_MODEL (ver abajo).
# "gemini" → Google AI Studio, PRUEBAS: la GEMINI_API_KEY de abajo
#            (gemini-3.1-flash-lite).
# Nota: separado del proveedor de EMBEDDINGS del RAG (MAAS_PROVEEDOR, abajo) —
# hoy el MaaS de Huawei (CN-Hong Kong) es solo de chat, sin embeddings.
IA_PROVEEDOR=maas

# ── Proveedor de los EMBEDDINGS del RAG (base de conocimiento) ──
# "gemini" → Google AI Studio (gemini-embedding-001 a 1024 dims). Es el que
#            funciona hoy: el MaaS de Huawei no expone embeddings.
# "maas"   → si tu despliegue MaaS los expone (bge-m3 a 1024 dims).
MAAS_PROVEEDOR=gemini

# ── Gemini (proveedor de pruebas) ──
# Clave de la API (aistudio.google.com → "Get API key"). La capa gratuita
# alcanza para las pruebas del agente.
GEMINI_API_KEY=
# Modelo de análisis (opcional: si se quita, se usa gemini-3.1-flash-lite —
# el más barato de los actuales; ver aistudio.google.com/docs/pricing).
#GEMINI_MODEL=gemini-3.1-flash-lite

# ── MaaS de Huawei (proveedor de producción) ──
# Al llegar las credenciales: pon MAAS_PROVEEDOR=maas (o borra la línea) y
# completa estas tres variables — con eso los informes los genera el MaaS.
#MAAS_API_KEY=
# MAAS_BASE_URL es el access point de TU despliegue MaaS (cada uno tiene el suyo).
#MAAS_BASE_URL=
# Nombre del modelo de chat desplegado en tu MaaS (no hay default: cada
# despliegue expone los suyos).
#MAAS_ANALISIS_MODEL=
# Embeddings del RAG (default bge-m3 a 1024 dims con maas).
#MAAS_EMBEDDING_MODEL=bge-m3
#MAAS_EMBEDDING_DIMS=1024
