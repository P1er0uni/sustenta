# Copia este archivo como ".env" y completa los valores para ejecutar el
# agente en local. En Vercel NO uses este archivo: configura OPENAI_API_KEY y
# GEMINI_API_KEY como variables de entorno del proyecto (process.env tiene
# prioridad).

# ── ANÁLISIS (quién genera los informes): OpenAI ──
# Clave de la API (platform.openai.com → API keys).
OPENAI_API_KEY=
# Modelo por defecto (opcional: si se quita, se usa gpt-5.6).
#OPENAI_MODEL=gpt-5.6

# ── EMBEDDINGS del RAG (base de conocimiento): Gemini ──
# Clave de la API (aistudio.google.com → "Get API key"). La capa gratuita
# alcanza para las pruebas; sin ella el RAG se omite (la app funciona igual).
GEMINI_API_KEY=
# Modelo de embeddings (opcional: default gemini-embedding-001 a 1024 dims —
# la dimensionalidad del índice ya existente en Storage).
#GEMINI_EMBEDDING_MODEL=gemini-embedding-001
#GEMINI_EMBEDDING_DIMS=1024
