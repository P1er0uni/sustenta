# Copia este archivo como ".env" y completa los valores para ejecutar el
# agente en local. En Vercel NO uses este archivo: configura GEMINI_API_KEY
# (y MAAS_* si aplica) como variables de entorno del proyecto (process.env
# tiene prioridad).

# Clave de la API de Gemini (aistudio.google.com → "Get API key"). La capa
# gratuita alcanza para las pruebas del agente.
GEMINI_API_KEY=

# Modelo de análisis (opcional: si se quita, se usa gemini-3.1-flash-lite —
# el más barato de los actuales; ver aistudio.google.com/docs/pricing).
#GEMINI_MODEL=gemini-3.1-flash-lite

# Embeddings del RAG (spec 002): "maas" (producción — MaaS de Huawei) o
# "gemini" (pruebas con la clave de arriba). Por defecto "gemini" para que
# esta descarga funcione con SOLO la GEMINI_API_KEY; al llegar las
# credenciales del MaaS, cambia a "maas" y define MAAS_API_KEY y MAAS_BASE_URL.
MAAS_PROVEEDOR=gemini
#MAAS_API_KEY=
#MAAS_BASE_URL=
#MAAS_EMBEDDING_MODEL=bge-m3
#MAAS_EMBEDDING_DIMS=1024
