# Integración con Microsoft Graph (Outlook/Teams) — lectura de reuniones.
# Copia este archivo como ".env" y completa los valores cuando tengas el app
# registration en Azure (ver README, sección "Conectar Outlook/Teams").
# Mientras VITE_MS_CLIENT_ID esté vacío, la integración queda inactiva y la app
# funciona con el modo demo o sin reuniones.

# ID de aplicación (client ID) del app registration en Microsoft Entra ID.
VITE_MS_CLIENT_ID=

# Tenant del app registration. Usa el tenant ID de tu organización (ej. la cuenta
# estudiantil) o "common" para permitir también cuentas personales de Microsoft.
VITE_MS_TENANT_ID=common
